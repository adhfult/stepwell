# Copy to .env.local and fill in. .env.local is never committed.
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Cloudflare Turnstile site key (public). Leave unset locally: the app then
# uses Cloudflare's always-pass test key. Real key: see docs/LAUNCH.md.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets go below WITHOUT the NEXT_PUBLIC_ prefix, e.g.:
# ANTHROPIC_API_KEY=

# --- Import jobs (npm run import) ---------------------------------------
# These live in GitHub Actions (Settings -> Secrets and variables), not in
# .env.local: the jobs read only their own environment. Locally, leave them
# unset and the jobs use the local Supabase stack. Setup: docs/LAUNCH.md.
# IMPORT_DATABASE_URL=postgresql://importer.<project-ref>:<password>@<pooler-host>:5432/postgres
# IMPORT_CONTACT=   (a variable, not a secret: the address in the User-Agent)
#
# Added by later build steps:
# ONET_API_KEY=            (Career Explorer: pay and outlook)
# SCORECARD_API_KEY=       (Programs and colleges)
# CAREERONESTOP_*, USAJOBS_* (names confirmed at registration)
# CONTEXT_DEV_API_KEY=     (Scholarships: hard pages only)
